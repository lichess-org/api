{
  "name": "lichess-api-doc",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "devDependencies": {
    "@redocly/cli": "^2.71.1",
    "@scalar/api-reference": "^1.76.0",
    "@scalar/cli": "^2.13.2",
    "@stoplight/spectral-cli": "^6.17.0",
    "@stoplight/spectral-rulesets": "^1.23.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vite-plugin-restart": "^2.0.0"
  },
  "scripts": {
    "dev": "pnpm bundle && vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "spectral": "spectral lint --fail-severity=warn specs/*.yaml",
    "lint": "redocly lint specs/lichess-api.yaml",
    "scalar-lint": "pnpm bundle && scalar document lint public/openapi.yaml && scalar document validate public/openapi.yaml",
    "bundle": "redocly bundle specs/lichess-api.yaml --output public/openapi.yaml",
    "format": "prettier . --write",
    "check-format": "prettier . --check"
  }
}
